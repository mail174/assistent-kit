#!/bin/bash
# Startet den Telegram-Listener.
# Modell hart gesetzt: verhindert das stille Runterfallen auf ein Modell,
# dessen Monatslimit den Bot lahmlegt.
#
# ACHTUNG: TELEGRAM_STATE_DIR kommt aus der Dienstdatei (assistent-bot.service).
# STATE_DIR hier und im Dienst muessen identisch sein mit dem Ordner, in dem
# /telegram:configure den Token abgelegt hat, sonst findet der Dienst den
# Token nicht und der Bot startet stumm ohne Kanal.
# Nicht plugin:telegram@claude-plugins-official, sondern ein von Hand
# eingetragener MCP-Server (claude mcp add telegram-haupt): plugin-gestartete
# Kanalserver bekommen KEINEN Env-Block, der Token muesste dann in
# $TELEGRAM_STATE_DIR/.env liegen. Ueber den eigenen Servereintrag reisen
# Token und Zustandsordner sauber mit (gefunden im Setup 24.08.2026).
CH="plugin:telegram@claude-plugins-official"
# Standard: Opus mit maximalem Effort, aenderbar wenn der Mensch anderes wuenscht.
EXTRA=(--permission-mode acceptEdits --model opus --effort max)

# Headless-Pflicht: ohne skipAutoPermissionPrompt haengt der Dienst beim
# Auto-Mode-Angebot ("Make auto mode your default permission mode?"), das
# ohne Tastatur niemand wegdruecken kann (gefunden im Setup 24.08.2026).
[ -s /root/.assistent-bot-settings.json ] && EXTRA+=(--settings /root/.assistent-bot-settings.json)

# Personalisierte Kopie aus vorlagen/, damit Kit-Updates per git pull konfliktfrei bleiben.
ROLLE="/root/assistent/rollen/bot-rolle.md"
[ -s "$ROLLE" ] && EXTRA+=(--append-system-prompt "$(cat "$ROLLE")")

# Uebergabebrief der Vorsitzung: eine Seite, geschrieben vom Vorgaenger kurz vor dem
# Neustart. Haelt fest, was in keinem System steht: laufende Faeden, Entscheidungen,
# offene Rueckfragen. Erzeugt von skripte/uebergabe-schreiben.sh.
UEBERGABE="/root/assistent/uebergabe/${ASSISTENT_DIENST:-haupt}.md"
[ -s "$UEBERGABE" ] && EXTRA+=(--append-system-prompt "$(cat "$UEBERGABE")")

# Session-Wiederaufnahme: der session-track-Hook (skripte/session-track.sh,
# Verdrahtung nach vorlagen/settings-muster.json) schreibt bei jeder Nachricht
# die Session-ID des Dienstes in die Pointer-Datei. Beim Neustart wird genau
# diese Session wiederaufgenommen; der Chat-Kontext ueberlebt so Nacht-,
# Wochen- und Waechter-Neustarts. Ohne gueltigen Pointer (erster Start, Hook
# noch nicht verdrahtet) startet der Bot frisch.
DIENST="${ASSISTENT_DIENST:-haupt}"
SID=$(tr -d '[:space:]' < "/root/.assistent-session-$DIENST" 2>/dev/null)

# Nach dem geplanten Nacht-Neustart bewusst frisch: den Stand traegt der Brief.
# Gemessen an einem seit Wochen laufenden Bot: eine Wiederaufnahme zieht 500k bis 900k
# Tokens ins Fenster, und nach jeder automatischen Verdichtung ueberleben davon ohnehin
# nur rund 20k maschinell zusammengefasste Tokens. Der Brief leistet dasselbe mit rund
# 1k, dafuer selbst kuratiert. Den Marker setzt skripte/nacht-neustart.sh, aber nur
# wenn wirklich ein frischer Brief geschrieben wurde.
FRISCH="/root/.assistent-frisch-$DIENST"
[ -f "$FRISCH" ] && { rm -f "$FRISCH"; SID=""; }

# Ungeplanter Neustart (Absturz, Waechter): wiederaufnehmen ist richtig, weil es dann
# keinen frischen Brief gibt. Aber nur, solange der Kontext nicht aufgeblaeht ist:
# sehr grosse Transkripte laden minutenlang und koennen den Start sprengen.
TRANS=$(find /root/.claude/projects -maxdepth 2 -name "$SID.jsonl" 2>/dev/null | head -1)
if [ -n "$SID" ] && [ -n "$TRANS" ] && command -v jq >/dev/null; then
  CTX=$(tac "$TRANS" | grep -m1 '"type":"assistant"' | jq '((.message.usage.input_tokens//0)+(.message.usage.cache_creation_input_tokens//0)+(.message.usage.cache_read_input_tokens//0))' 2>/dev/null)
  if [ "${CTX:-0}" -gt "${ASSISTENT_KONTEXT_DECKEL:-200000}" ]; then
    echo "[assistent-bot-start] Kontext $CTX ueber Deckel, starte frisch" >&2
    SID=""
  fi
fi

if [ -n "$SID" ] && [ -n "$(find /root/.claude/projects -maxdepth 2 -name "$SID.jsonl" 2>/dev/null | head -1)" ]; then
  claude --resume "$SID" --channels "$CH" "${EXTRA[@]}"
  rc=$?
  [ "$rc" -eq 0 ] && exit 0
  echo "[assistent-bot-start] Wiederaufnahme von Session $SID fehlgeschlagen (rc=$rc), starte frisch" >&2
fi
exec claude --channels "$CH" "${EXTRA[@]}"
